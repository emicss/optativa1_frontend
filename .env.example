# ===============================================
# Configuración de Conexión a AWS RDS (MySQL / MariaDB)
# ===============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=facturacion_db
DB_PORT=3306

# ===============================================
# Configuración AWS DynamoDB (Opcional / Auditoría)
# ===============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_IDEMPOTENCIA=facturacion_idempotencia
DYNAMODB_TABLE_LOGS=log_eventos_facturacion

# Configuración de la Aplicación Flask
FLASK_ENV=development
PORT=5000
